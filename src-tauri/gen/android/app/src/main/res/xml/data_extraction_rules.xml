<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new phone: the app holds this
     device's Cloud key and credential, which must never turn up on another
     device, and its synced chats come back from the user's machines. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
