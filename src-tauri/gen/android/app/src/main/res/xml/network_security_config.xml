<?xml version="1.0" encoding="utf-8"?>
<!-- The console talks plain HTTP only to the daemon inside this app, on
     loopback: its content security policy allows it nothing else. The
     built-in browser opens http:// pages as any browser does, marked "Not
     secure" (a router's page, a dev server on the network, an old site), so
     the app as a whole permits plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
