{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRemote",
  "version": "0.5.1",
  "identifier": "space.moreweb.openremote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRemote",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#0a0c0f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' http://tauri.localhost https://tauri.localhost tauri://localhost blob:; frame-src blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/morewebs/OpenRemote/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (C) 2026 moreweb",
    "android": {
      "minSdkVersion": 26,
      "versionCode": 15
    },
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": [
      "../LICENSE",
      "../THIRD-PARTY_NOTICES.md"
    ],
    "externalBin": [
      "binaries/openremote-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
