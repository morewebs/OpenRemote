{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "The Android app: the console and the app's own commands, the built-in browser's included; the shell opens pages and hears the sign-in's return address itself, and the browser's pages (native views of their own, with no IPC) reach none of these",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "allow-daemon-info",
    "allow-open-url",
    "allow-browser-open",
    "allow-browser-features",
    "allow-browser-tabs",
    "allow-browser-close",
    "allow-browser-set-bounds",
    "allow-browser-show",
    "allow-browser-hide",
    "allow-browser-navigate",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-browser-stop",
    "allow-browser-capture",
    "allow-browser-zoom",
    "allow-browser-find",
    "allow-browser-permission",
    "allow-browser-clear-site",
    "allow-browser-clear-data",
    "allow-browser-open-external",
    "allow-browser-share",
    "allow-browser-save-file",
    "allow-browser-reveal",
    "allow-browser-desktop-site",
    "allow-browser-share-sheet",
    "allow-browser-download"
  ]
}
