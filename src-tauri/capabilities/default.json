{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The console's webview only (never the built-in browser's tabs): frameless caption controls and the app's own commands; the shell owns the daemon sidecar itself",
  "webviews": [
    "main"
  ],
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "allow-daemon-info",
    "allow-daemon-restart",
    "allow-reveal-in-folder",
    "allow-tray-prefs",
    "allow-set-tray-prefs",
    "allow-window-prefs",
    "allow-set-window-prefs",
    "allow-browser-open",
    "allow-browser-features",
    "allow-browser-tabs",
    "allow-browser-close",
    "allow-browser-set-bounds",
    "allow-browser-show",
    "allow-browser-hide",
    "allow-browser-navigate",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-browser-capture",
    "allow-browser-cdp",
    "allow-browser-stop",
    "allow-browser-zoom",
    "allow-browser-find",
    "allow-browser-print",
    "allow-browser-devtools",
    "allow-browser-viewport",
    "allow-browser-clear-site",
    "allow-browser-open-external",
    "allow-browser-reveal",
    "allow-browser-permission",
    "allow-browser-pick",
    "allow-browser-screencast",
    "allow-browser-save-file",
    "allow-browser-clear-data",
    "allow-browser-share",
    "allow-update-check",
    "allow-update-install"
  ]
}
