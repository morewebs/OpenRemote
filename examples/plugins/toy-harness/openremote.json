{
  "api": 1,
  "name": "toy-harness",
  "version": "0.2.0",
  "description": "A toy command-line agent as an OpenRemote harness, and two agent tools. An example of a process plugin: one compiled program in the plugin's own folder.",
  "runtime": "process",
  "entry": {
    "command": "bin/toy",
    "args": ["--tools"],
    "windows": { "command": "bin/toy.exe", "args": ["--tools"] }
  },
  "harness": {
    "api": 1,
    "id": "toy",
    "name": "Toy CLI",
    "driver": {
      "windows": "bin/toy.exe",
      "default": "bin/toy"
    },
    "args": ["--driver"],
    "models": [
      { "model": "toy-echo", "display_name": "Toy Echo", "is_default": true },
      { "model": "toy-mirror", "display_name": "Toy Mirror", "detail": "Says it backwards" }
    ],
    "default_model": "toy-echo",
    "permission_modes": [
      { "w": "ask", "l": "Ask before shouting" },
      { "w": "allow", "l": "Shout without asking" }
    ],
    "default_permission": "ask"
  },
  "contributes": {
    "tools": [
      {
        "name": "word_count",
        "description": "Count the words, lines and characters in a piece of text.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "description": "The text to count." }
          },
          "required": ["text"]
        },
        "read_only": true
      },
      {
        "name": "greet",
        "description": "Greet someone with the greeting set in the plugin's settings.",
        "input_schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Who to greet." }
          }
        },
        "read_only": true
      }
    ],
    "settings": [
      {
        "key": "greeting",
        "type": "string",
        "label": "Greeting",
        "help": "What the greet tool says before the name.",
        "default": "Hello"
      },
      {
        "key": "token",
        "type": "secret",
        "label": "Token",
        "help": "A pretend API token, to show how a secret reaches a plugin's program. The toy only says whether one is set."
      }
    ]
  }
}
