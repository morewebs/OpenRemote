dist/
# internal/core/server/static.go embeds dist via //go:embed all:dist/*, which
# fails to compile when no file matches. Track the placeholder so a fresh clone
# builds; the real Flutter web bundle is generated by `flutter build web` and
# injected into this directory by the release pipeline.
!internal/core/server/dist/
internal/core/server/dist/*
!internal/core/server/dist/.gitkeep
.next/
out/
.turbo/
*.tsbuildinfo
*.sqlite
*.sqlite-wal
*.sqlite-shm
.openremote/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/


